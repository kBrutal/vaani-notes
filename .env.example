NVIDIA_API_KEY=nvapi-...
# HF account must have accepted the gate on huggingface.co/bodhan-ai/indic-transcribe-core
HF_TOKEN=hf_...
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# reasoning for interactive answers (notes always reason, in the background); on = ~4x slower
LLM_THINKING=off
ASR_MODEL=bodhan-ai/indic-transcribe-core
ASR_MODE=native
# blank = cuda > mps (Apple GPU) > cpu
ASR_DEVICE=
# knobs: tune after you have ~50 real notes
LINK_MIN=0.4

# --- MongoDB Atlas (notes + vector search in one place) ---
# Atlas > your cluster > Connect > Drivers > Python: copy the SRV string, put in the DB user's password.
# Also: Network Access must allow your IP, and the DB user needs readWrite (it creates the vector index on first start).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=vaani
# database name inside the cluster (created automatically)
MONGODB_DB=vaani
# embedding size of EMBED_MODEL; change only if you switch embedding models (then drop the note_vectors index)
EMBED_DIMS=2048
