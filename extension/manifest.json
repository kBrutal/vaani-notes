{
  "manifest_version": 3,
  "name": "Vaani Notes",
  "version": "0.2.0",
  "description": "Speak what you understood while studying on the web. Vaani turns it into structured, linked notes.",
  "permissions": ["sidePanel", "scripting", "tabs", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Vaani Notes (Alt+Shift+N)" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Open Vaani" },
    "toggle-recording": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Start / stop a voice note" }
  }
}
